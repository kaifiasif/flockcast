# Copy to .env (or set these in your host's dashboard). Everything is optional.

# --- Server
PORT=4180
# HOST=0.0.0.0                       # listen beyond this machine (behind HTTPS)
REHEARSAL_DB=data/rehearsal.db
# NODE_ENV=production                # secure, __Host- session cookies; needs HTTPS
# TRUST_PROXY=true                   # behind Render, Fly, nginx: read the visitor's IP from X-Forwarded-For

# --- Accounts
REHEARSAL_SIGNUP=closed              # closed: only the first account (or the owner email) can sign up. open: anyone
# REHEARSAL_OWNER_EMAIL=you@example.com   # on a public server, only this email can create the first account

# --- The model (free options first). No key at all = offline estimate, clearly labelled.
REHEARSAL_LLM_PROVIDER=groq          # groq | gemini | openrouter | ollama | openai | custom
REHEARSAL_LLM_API_KEY=               # free keys: console.groq.com, aistudio.google.com, openrouter.ai
# REHEARSAL_LLM_MODEL=               # defaults per provider, e.g. openai/gpt-oss-120b on Groq
# REHEARSAL_LLM_BASE_URL=            # only for custom; https, or http on localhost
# LLM_API_KEY= / LLM_BASE_URL=       # generic shared names, read when the REHEARSAL_ ones are unset

# --- The agents are Python 3.10+ (standard library only). Point this at another interpreter if python3 is not it.
# FLOCKCAST_PYTHON=python3

# --- Optional engine: a MiroFish server you run yourself (AGPL, separate process; see sidecar/)
# REHEARSAL_ENGINE=mirofish
# MIROFISH_URL=http://localhost:5001

# --- Launch advisor research: Hacker News and Reddit need no key; sample = canned findings for demos
# ADVISOR_SOURCES=hackernews,reddit  # add ",web" with a Tavily key
# TAVILY_API_KEY=                    # optional, free tier at tavily.com: general web search
# ADVICE_PER_PROJECT_PER_DAY=5

# --- Spend caps
# REHEARSALS_PER_SUBJECT_PER_DAY=10
# INTERVIEWS_PER_REHEARSAL=25
