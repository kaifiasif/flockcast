# Copy to sidecar/.env. MiroFish needs an OpenAI-compatible LLM and a Zep Cloud key.

# --- LLM, free option: Google Gemini free tier via its OpenAI-compatible endpoint ---
# Key from https://aistudio.google.com/apikey (no card needed). Free tier is rate limited per minute,
# so keep rehearsals small (10 rounds or fewer in the Flockcast project).
LLM_API_KEY=your_gemini_key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL_NAME=gemini-2.5-flash

# --- LLM, fully local alternative: Ollama (no key, no rate limit, needs a decent machine) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL_NAME=qwen2.5:7b

# --- Zep Cloud memory graph (required; MiroFish refuses self-hosted Zep) ---
# Free monthly quota at https://app.getzep.com/
ZEP_API_KEY=your_zep_key

# Lower the default simulation length for free-tier quotas.
OASIS_DEFAULT_MAX_ROUNDS=10
